{
  "name": "polka-mvp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "import:products": "python3 apps/backend/scripts/import-products.py",
    "import:recipes": "python3 apps/backend/scripts/import-recipe-library.py",
    "import:recipes:ru": "python3 apps/backend/scripts/import-rurecipes.py",
    "import:products:bulk": "python3 apps/backend/scripts/import-off-bulk.py",
    "dev": "npm run dev -w @polka/web",
    "dev:bot": "npm run dev -w @polka/bot",
    "build": "npm run build -w @polka/web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run build:backend",
    "deploy:bot": "npm run deploy -w @polka/bot",
    "build:ai": "npm run build:backend",
    "dev:backend": "npm run dev -w @polka/backend",
    "build:backend": "npm run build -w @polka/backend",
    "db:up": "docker compose up -d database",
    "db:stop": "docker compose stop database",
    "db:migrate": "npm run db:migrate -w @polka/backend",
    "test:database": "vitest run tests/accounts.integration.test.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
