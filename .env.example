# Server only. Copy into the root .env; never use a VITE_ prefix for the API key.
API_GLM=

# Allowed browser origins, comma-separated, without paths or trailing slashes.
# Timeweb container: https://polka.net.ru
ALLOWED_ORIGIN=https://eshevlyakova.github.io

# For a combined production server, not required for local Vite or a function.
# APP_ORIGIN=https://polka.net.ru
# WEB_DIST=/app/apps/web/dist

# Closed browser tests, when Telegram authorization is not configured.
# Choose a non-empty random code and share it only with your testers.
AI_TEST_CODE=

# Existing Telegram bot token, server only. Required for account sign-in.
BOT_TOKEN=

# Account storage. Local Docker only; use a private credential for hosting.
DATABASE_URL=postgresql://polka:polka_local_only@127.0.0.1:54329/polka
