{
  "name": "@polka/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=../../.env dist/server.cjs",
    "build": "node ../../scripts/build-backend.mjs",
    "typecheck": "tsc --noEmit",
    "import:catalogs": "python3 scripts/import-catalogs.py",
    "db:migrate": "npm run build && node --env-file-if-exists=../../.env dist/apps/backend/src/db/migrate.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
